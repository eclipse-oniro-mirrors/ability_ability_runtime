#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")
module_output_path = "ability_runtime/abilitymgr"

##############################fuzztest##########################################
ohos_fuzztest("MissionManagerClientFuzzTest") {
  module_out_path = module_output_path

  fuzz_config_file =
      "${ability_runtime_test_path}/fuzztest/missionmanagerclient_fuzzer"

  include_dirs = [
    "${ability_runtime_innerkits_path}/mission_manager/include",
    "${ability_runtime_innerkits_path}/ability_manager/include",
    "${ability_runtime_services_path}/common/include",
    "${ability_runtime_test_path}/fuzztest/common",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  sources = [ "missionmanagerclient_fuzzer.cpp" ]

  configs = [
    "${ability_runtime_innerkits_path}/mission_manager:mission_manager_public_config",
    "${ability_runtime_innerkits_path}/ability_manager:ability_manager_public_config",
  ]

  deps = [
    "${ability_runtime_innerkits_path}/mission_manager:mission_manager",
    "${ability_runtime_innerkits_path}/ability_manager:mission_info",
  ]

  external_deps = [
    "ability_base:session_info",
    "ability_base:want",
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "hilog:libhilog",
    "image_framework:image_native",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
    "window_manager:libwsutils",
    "window_manager:session_manager_lite"
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":MissionManagerClientFuzzTest",
  ]
}
###############################################################################
