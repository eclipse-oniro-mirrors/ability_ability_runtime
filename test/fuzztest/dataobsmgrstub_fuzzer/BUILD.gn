#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")
module_output_path = "ability_runtime/abilitymgr"

##############################fuzztest##########################################
ohos_fuzztest("DataObsMgrStubFuzzTest") {
  module_out_path = module_output_path

  fuzz_config_file =
      "${ability_runtime_test_path}/fuzztest/dataobsmgrstub_fuzzer"
  include_dirs = [
    "${ability_runtime_innerkits_path}/dataobs_manager/include",
    "${ability_runtime_services_path}/dataobsmgr/include",
    "${ability_runtime_innerkits_path}/ability_manager/include",
    "${ability_runtime_test_path}/fuzztest/common",
  ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [
    "${ability_runtime_services_path}/dataobsmgr/src/dataobs_mgr_stub.cpp",
    "dataobsmgrstub_fuzzer.cpp",
  ]

  configs = [
    "${ability_runtime_innerkits_path}/dataobs_manager:dataobs_manager_public_config",
    "${ability_runtime_services_path}/dataobsmgr:dataobsms_config",
    "${ability_runtime_test_path}/fuzztest:no_split_lto_unit"
  ]

  deps = [
    "${ability_runtime_innerkits_path}/dataobs_manager:dataobs_manager",
    "${ability_runtime_services_path}/dataobsmgr:dataobsms",
  ]

  external_deps = [
    "ability_base:want",
    "ability_base:zuri",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    ":DataObsMgrStubFuzzTest",
  ]
}
###############################################################################
