import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")
import("//foundation/ability/ability_runtime/service_router_framework/srms.gni")

module_output_path = "ability_runtime/ability_runtime/serviceroutermgrservice"

ohos_unittest("service_router_mgr_service_test") {
  module_out_path = module_output_path

  configs = [
    "${ability_runtime_innerkits_path}/ability_manager:ability_manager_public_config",
    "${ability_runtime_path}/service_router_framework/interfaces/inner_api:srms_fwk_config",
    "${ability_runtime_path}/service_router_framework/services/srms:srms_config",
  ]
  # 注意：此处直编 libsrms 的全部源文件，后续 abilitymgr/srms 增删源文件或宏时须同步本列表
  sources = [
    "service_router_mgr_service_test.cpp",
    "${srms_services_path}/src/inner_service_info.cpp",
    "${srms_services_path}/src/service_router_data_mgr.cpp",
    "${srms_services_path}/src/service_router_mgr_service.cpp",
    "${srms_services_path}/src/sr_common_event_subscriber.cpp",
    "${srms_services_path}/src/sr_samgr_helper.cpp",
  ]

  defines = [ "ACCOUNT_ENABLE" ]

  cflags = []

  deps = [
    "${ability_runtime_innerkits_path}/ability_manager:ability_manager",
    "${ability_runtime_native_path}/appkit:appkit_manager_helper",
    "${srms_inner_api_path}:service_router_mgr_stub",
    "${srms_inner_api_path}:srms_fwk",
  ]

  external_deps = [
    "ability_base:session_info",
    "ability_base:want",
    "ability_base:zuri",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "bundle_framework:libappexecfwk_common",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "eventhandler:libeventhandler",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_single",
    "os_account:os_account_innerkits",
    "safwk:api_cache_manager",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]
}
group("unittest") {
  testonly = true

  deps = [ ":service_router_mgr_service_test" ]
}
