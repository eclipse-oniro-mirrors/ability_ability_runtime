import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/abilitymgr"

config("test_exception_config") {
  cflags_cc = [ "-fexceptions" ]
}

ohos_unittest("sub_spawn_manager_test") {
  module_output_path = module_output_path

  include_dirs = [
    "${ability_runtime_services_path}/appmgr/include",
    "${ability_runtime_path}/interfaces/inner_api/app_manager/include",
    "${ability_runtime_path}/interfaces/inner_api/app_manager/include/appmgr",
    "${ability_runtime_services_path}/common/include",
  ]

  public_configs =
      [ "${ability_runtime_services_path}/abilitymgr:abilityms_config" ]

  configs = [":test_exception_config"]

  sources = [
    "${ability_runtime_services_path}/appmgr/src/sub_spawn_manager.cpp",
    "${ability_runtime_services_path}/appmgr/src/sub_spawn_record.cpp",
    "appspawn_stub.cpp",
    "sub_spawn_manager_test.cpp",
  ]

  deps = [
    "${ability_runtime_services_path}/common:app_util",
    "${ability_runtime_services_path}/common:perm_verification",
    "${ability_runtime_services_path}/common:task_handler_wrap",
  ]

  external_deps = [
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  cflags_cc = []
}

group("unittest") {
  testonly = true

  deps = [ ":sub_spawn_manager_test" ]
}
