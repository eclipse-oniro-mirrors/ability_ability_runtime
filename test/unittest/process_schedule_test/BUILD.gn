import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/appmgrservice"

ohos_unittest("process_schedule_test") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "../../cfi_blocklist.txt"
  }
  branch_protector_ret = "pac_ret"
  module_out_path = module_output_path

  sources = [
    "${ability_runtime_services_path}/appmgr/src/task_mgr/attribution_record.cpp",
    "${ability_runtime_services_path}/appmgr/src/task_mgr/common.cpp",
    "${ability_runtime_services_path}/appmgr/src/task_mgr/process_schedule.cpp",
    "process_schedule_test.cpp",
  ]

  configs = [ "${ability_runtime_services_path}/appmgr:appmgr_config" ]

  deps = [ "${ability_runtime_services_path}/common:task_handler_wrap" ]

  external_deps = [
    "c_utils:utils",
    "ffrt:libffrt",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]

  defines = []
}

group("unittest") {
  testonly = true

  deps = [ ":process_schedule_test" ]
}
