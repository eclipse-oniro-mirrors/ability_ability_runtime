import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/appkit"

ohos_unittest("bindable_sub_thread_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "../../cfi_blocklist.txt"
  }

  include_dirs = [
    "mock/include",
    "${ability_runtime_path}/interfaces/kits/native/appkit/ability_runtime/context",
  ]

  sources = [
    "${ability_runtime_path}/frameworks/native/appkit/ability_runtime/context/bindable_sub_thread.cpp",
    "bindable_sub_thread_test.cpp",
  ]

  configs = [ "${ability_runtime_services_path}/abilitymgr:abilityms_config" ]

  deps = [
    "${ability_runtime_innerkits_path}/ability_manager:ability_manager",
  ]

  external_deps = [
    "c_utils:utils",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "hitrace:hitrace_meter",
    "ipc:ipc_core",
    "libuv:uv",
    "node:node_header_notice",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":bindable_sub_thread_test" ]
}
