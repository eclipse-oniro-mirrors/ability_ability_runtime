import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/abilitymgr"

ohos_unittest("insight_intent_db_cache_test") {
  configs = ["//build/config/compiler:exceptions"]
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "../../cfi_blocklist.txt"
  }
  module_out_path = module_output_path

  include_dirs = [
    "mock/include",
    "${ability_runtime_abilitymgr_path}/include",
    "${ability_runtime_abilitymgr_path}/src",
  ]

  sources = [
    "${ability_runtime_services_path}/abilitymgr/src/insight_intent/extract_insight_intent_profile.cpp",
    "${ability_runtime_services_path}/abilitymgr/src/insight_intent/function_call_convert.cpp",
    "${ability_runtime_services_path}/abilitymgr/src/insight_intent/insight_intent_db_cache.cpp",
    "${ability_runtime_services_path}/abilitymgr/src/insight_intent/insight_intent_event_mgr.cpp",
    "${ability_runtime_services_path}/abilitymgr/src/insight_intent/insight_intent_sys_event_receiver.cpp",
    "insight_intent_db_cache_test.cpp",
    "mock/src/mock_bundle_mgr_helper.cpp",
    "mock_insight_intent_rdb_storage_mgr.cpp",
  ]

  deps = [
    "${ability_runtime_abilitymgr_path}/:abilityms",
    "${ability_runtime_path}/utils/global/common:runtime_utils",
    "${ability_runtime_innerkits_path}/ability_manager:ability_manager",
    "${ability_runtime_innerkits_path}/deps_wrapper:ability_deps_wrapper",
    "${cli_tool_framework_path}/interfaces/cli_tool:cli_tool_client",
  ]

  external_deps = [
    "ability_base:want",
    "ability_base:zuri",
    "access_token:libaccesstoken_sdk",
    "bundle_framework:libappexecfwk_common",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
    "relational_store:native_rdb",
  ]
}

group("unittest") {
  testonly = true

  deps = [ ":insight_intent_db_cache_test" ]
}
