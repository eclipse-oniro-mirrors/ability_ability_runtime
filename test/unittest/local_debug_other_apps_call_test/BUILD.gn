import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/common"

ohos_unittest("local_debug_other_apps_call_test") {
  module_out_path = module_output_path

  include_dirs = [ "mock/include" ]

  sources = [
    "local_debug_other_apps_call_test.cpp",
    "mock/src/mock_accesstoken_kit.cpp",
    "mock/src/mock_my_status.cpp",
    "mock/src/mock_parameters.cpp",
  ]

  # perm_verification is built without Bsymbolic to allow symbol mocking:
  # AccessTokenKit::VerifyAccessToken and system::GetBoolParameter are
  # intercepted by local mocks so that all branches of
  # PermissionVerification::IsLocalDebugOtherAppsCall are covered.
  deps = [
    "${ability_runtime_services_path}/common:perm_verification_static",
  ]

  external_deps = [
    "ability_base:want",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "hitrace:hitrace_meter",
    "init:libbegetutil",
    "ipc:ipc_core",
  ]
}

group("unittest") {
  testonly = true

  deps = [ ":local_debug_other_apps_call_test" ]
}
