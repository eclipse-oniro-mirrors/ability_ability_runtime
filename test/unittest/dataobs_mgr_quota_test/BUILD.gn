import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/dataobsmgr"

ohos_unittest("dataobs_mgr_quota_test") {
  module_out_path = module_output_path

  include_dirs = []

  sources = [ "dataobs_mgr_quota_test.cpp" ]

  configs = [ "${ability_runtime_services_path}/dataobsmgr:dataobsms_config" ]
  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  deps = [
    "${ability_runtime_innerkits_path}/dataobs_manager:dataobs_manager",
    "${ability_runtime_services_path}/dataobsmgr:dataobsms_static",
  ]

  external_deps = [
    "ability_base:want",
    "ability_base:zuri",
    "access_token:libtoken_setproc",
    "access_token:libaccesstoken_sdk",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "common_event_service:cesfwk_innerkits",
    "data_share:datashare_permission",
    "c_utils:utils",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
}

group("unittest") {
  testonly = true

  deps = [ ":dataobs_mgr_quota_test" ]
}
