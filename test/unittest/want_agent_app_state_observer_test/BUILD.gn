import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/abilitymgr"

ohos_unittest("want_agent_app_state_observer_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "../../cfi_blocklist.txt"
  }
  branch_protector_ret = "pac_ret"

  include_dirs = [
    "${ability_runtime_services_path}/abilitymgr/include",
    "${ability_runtime_innerkits_path}/app_manager/include/appmgr/",
  ]

  sources = [
    "${ability_runtime_services_path}/abilitymgr/src/want_agent_app_state_observer.cpp",
    "want_agent_app_state_observer_test.cpp",
  ]

  deps = [ "${ability_runtime_innerkits_path}/app_manager:app_manager" ]

  external_deps = [
    "ability_base:configuration",
    "ability_base:want",
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":want_agent_app_state_observer_test" ]
}