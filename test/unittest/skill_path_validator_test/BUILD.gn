import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/abilitymgr"

ohos_unittest("skill_path_validator_test") {
  module_out_path = module_output_path

  include_dirs = [
    "${ability_runtime_native_path}/ability/native",
  ]

  sources = [
    "skill_path_validator_test.cpp",
    "${ability_runtime_native_path}/ability/native/skill/skill_path_validator.cpp",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]
}

group("unittest") {
  testonly = true

  deps = [ ":skill_path_validator_test" ]
}
