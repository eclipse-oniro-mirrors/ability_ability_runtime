/*
 * ITaskManager is hosted by AppMgrService (SA 501) via interface-descriptor routing in
 * AppMgrService::OnRemoteRequest: requests carrying the "ohos.appexecfwk.ITaskManager"
 * descriptor are delegated to the TaskManagerStub, while IAppMgr traffic is unchanged.
 * The client obtains the proxy with iface_cast<ITaskManager>(GetSystemAbility(501)).
 */
interface OHOS.AppExecFwk.ITaskManager {
    int StartTask([in] String taskId, [in] int priority);
    int FinishTask([in] String taskId);
    // New methods MUST be appended at the END: IDL codegen assigns transaction codes by
    // declaration order; a mid-interface insertion shifts existing codes and breaks OTA-mixed
    // proxy/stub interop.
}
