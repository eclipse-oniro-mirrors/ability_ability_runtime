import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

config("daemon_service_manager_config") {
  visibility = [ ":*" ]
  include_dirs = [ "include" ]
}

ohos_shared_library("daemon_service_manager") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  sources = [ "src/daemon_service_manager_client.cpp" ]
  include_dirs =
      [ "${ability_runtime_innerkits_path}/app_manager/include/appmgr" ]
  public_configs = [ ":daemon_service_manager_config" ]
  deps = [ "${ability_runtime_innerkits_path}/app_manager:app_manager" ]
  external_deps = [
    "c_utils:utils",
    "init:libbegetutil",
    "ipc:ipc_core",
  ]

  innerapi_tags = [ "platformsdk" ]
  subsystem_name = "ability"
  part_name = "ability_runtime"
}
