import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

# Unit tests for the ohos-agent CLI tool (issue-16055). Compiles cli_agent_connection.cpp +
# session_protocol.cpp directly so the public entry RunCommandLoop (and thus the file-local
# DispatchLine) is exercised, alongside the pure-logic helpers (EscapeJsonString, event builders),
# the CliAgentConnectorStub host callbacks, the OnAbilityConnectDone CR-1 proxy-null guard, and the
# disconnect 防重入 state machine (TASK-5).
ohos_unittest("ohos_agent_test") {
  module_out_path = "ability_runtime/ability_runtime/tools/ohos_agent_test"

  sources = [
    "ohos_agent_test.cpp",
    "../src/cli_agent_connection.cpp",
    "../src/session_protocol.cpp",
  ]

  include_dirs = [
    "../include",
    "${agent_runtime_framework_path}/interfaces/kits/native/agent_extension/connection/include",
    "${agent_runtime_framework_path}/interfaces/inner_api/include",
    "${ability_runtime_services_path}/common/include",
  ]

  deps = [
    "${ability_runtime_innerkits_path}/ability_manager:ability_connect_callback_stub",
    "${agent_runtime_framework_path}/interfaces/inner_api:agent_manager",
    "${agent_runtime_framework_path}/interfaces/kits/native/agent_extension/connection:agent_extension_connection",
  ]

  external_deps = [
    "ability_base:base",
    "ability_base:want",
    # snprintf_s (EscapeJsonString) comes from securec.
    "bounds_checking_function:libsec_shared",
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_core",
    "json:nlohmann_json_static",
  ]

  cflags_cc = []
}

group("unittest") {
  testonly = true
  deps = [ ":ohos_agent_test" ]
}
