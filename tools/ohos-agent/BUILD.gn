import("//build/test.gni")
import("//build/ohos/cli/ohos_cli_executable.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

config("ohos_agent_command_config") {
  include_dirs = [
    "include",
    "${ability_runtime_path}/tools/aa/include",
    "${ability_runtime_innerkits_path}/ability_manager/include",
    "${ability_runtime_innerkits_path}/app_manager/include/appmgr",
    "${ability_runtime_path}/interfaces/kits/native/ability/native",
    "${agent_runtime_framework_path}/interfaces/kits/native/agent_extension/connection/include",
    "${agent_runtime_framework_path}/interfaces/inner_api/include",
  ]
}

config("ohos_agent_command_exception_config") {
  cflags_cc = [ "-fexceptions" ]
}

config("ohos_agent_lto_backend_config") {
  # See the note on the ohos-agent executable target for why this is a config.
  ldflags = [ "-Wl,--lto-O2" ]
}

ohos_static_library("ohos_agent_cli_source_set") {
  branch_protector_ret = "pac_ret"

  sources = [
    "src/cli_agent_connection.cpp",
    "src/ohos_agent_command.cpp",
    "src/session_protocol.cpp",
    "${ability_runtime_path}/tools/aa/src/shell_command.cpp",
    "${ability_runtime_path}/tools/aa/src/shell_command_result.cpp",
  ]

  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  public_configs = [
    ":ohos_agent_command_config",
    ":ohos_agent_command_exception_config",
  ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  # TASK-2: connect logic depends on AgentManagerClient (inner_api :agent_manager) + the
  # agent extension connection kit (:agent_extension_connection). Only the shell framework base
  # (shell_command.cpp / shell_command_result.cpp) is reused from tools/aa; the executor and the
  # config loader are aa-specific (popen / aa command whitelist) and unreferenced here.
  deps = [
    "${ability_runtime_innerkits_path}/ability_manager:ability_connect_callback_stub",
    "${agent_runtime_framework_path}/interfaces/inner_api:agent_manager",
    "${agent_runtime_framework_path}/interfaces/kits/native/agent_extension/connection:agent_extension_connection",
  ]

  external_deps = [
    "ability_base:base",
    "ability_base:want",
    # snprintf_s (EscapeJsonString) comes from securec.
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "json:nlohmann_json_static",
  ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
  configs = [
    "${ability_runtime_services_path}/common:size_optimize_config",
    "${ability_runtime_services_path}/abilitymgr:abilityms_config",
    "${ability_runtime_services_path}/common:common_config",
  ]
}

ohos_cli_executable("ohos-agent") {
  branch_protector_ret = "pac_ret"

  sources = [ "src/main.cpp" ]

  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  deps = [ ":ohos_agent_cli_source_set" ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "hicollie:libhicollie",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]

  # Self-contained ThinLTO backend optimization: appexecfwk_base used to be linked solely to
  # inherit "-Wl,--lto-O2" from its config; keeping the flag in a local config avoids depending
  # on another part's linker config (a BMS-side flag move would silently regress this binary by
  # ~9.6KB). NOTE: the flag MUST travel via a config, not the target-level "ldflags" variable:
  # target ldflags are ordered BEFORE the global default "-Wl,--lto-O0" (build/config/ohos/
  # BUILD.gn, enable_lto_O0) and would be silently overridden by it, whereas config ldflags are
  # appended after the defaults and take effect (lld keeps the last --lto-O occurrence).
  configs = [
    "${ability_runtime_services_path}/common:size_optimize_config",
    ":ohos_agent_lto_backend_config",
  ]

  defines = []

  install_enable = true
  install_images = [ "system" ]
  cli_config_file = "ohos-agent.json"
  subsystem_name = "ability"
  part_name = "ability_runtime"
}

group("tools_ohos_agent") {
  deps = [
    ":ohos-agent",
  ]
}
